<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Nunito:wght@200;300;400&display=swap" rel="stylesheet">

{%- style -%}
  .product-showcase {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: #FAF7F2;
  }
{%- endstyle -%}

<div class="product-showcase page-width">

  {%- if section.settings.title != blank or section.settings.show_all_link -%}
    <div class="product-showcase__header">
      {%- if section.settings.title != blank -%}
        <h2 class="product-showcase__title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.show_all_link and section.settings.collection != blank -%}
        <a href="{{ collections[section.settings.collection].url }}" class="product-showcase__view-all">
          {{ section.settings.view_all_label | default: 'Shop all' }}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- assign featured_collection = collections[section.settings.collection] -%}
  {%- assign products_to_show = section.settings.products_to_show -%}

  {%- if featured_collection != blank and featured_collection.products.size > 0 -%}
    <ul class="product-showcase__grid" role="list">
      {%- for product in featured_collection.products limit: products_to_show -%}
        <li class="product-showcase__item">
          <a href="{{ product.url }}" class="product-showcase__card" aria-label="{{ product.title | escape }}">

            {%- comment -%} Image area {%- endcomment -%}
            <div class="product-showcase__media-wrapper">

              {%- comment -%} Sale badge {%- endcomment -%}
              {%- if product.compare_at_price > product.price -%}
                <span class="product-showcase__badge">Sale</span>
              {%- endif -%}

              {%- comment -%} Primary image {%- endcomment -%}
              {%- if product.featured_image != blank -%}
                <img
                  class="product-showcase__image product-showcase__image--primary"
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  width="600"
                  height="{{ 600 | divided_by: product.featured_image.aspect_ratio | round }}"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'product-showcase__image product-showcase__image--primary placeholder-svg' }}
              {%- endif -%}

              {%- comment -%} Secondary (hover) image {%- endcomment -%}
              {%- if product.images.size > 1 -%}
                <img
                  class="product-showcase__image product-showcase__image--secondary"
                  src="{{ product.images[1] | image_url: width: 600 }}"
                  alt="{{ product.images[1].alt | default: product.title | escape }}"
                  width="600"
                  height="{{ 600 | divided_by: product.images[1].aspect_ratio | round }}"
                  loading="lazy"
                >
              {%- endif -%}

            </div>

            {%- comment -%} Product info {%- endcomment -%}
            <div class="product-showcase__info">
              <p class="product-showcase__product-title">{{ product.title | escape }}</p>

              <div class="product-showcase__price">
                {%- if product.compare_at_price > product.price -%}
                  <span class="product-showcase__price--compare">
                    {{- product.compare_at_price | money -}}
                  </span>
                  <span class="product-showcase__price--sale">
                    {{- product.price | money -}}
                  </span>
                {%- else -%}
                  <span class="product-showcase__price--regular">
                    {{- product.price | money -}}
                  </span>
                {%- endif -%}
              </div>
            </div>

          </a>
        </li>
      {%- endfor -%}
    </ul>

  {%- else -%}
    {%- comment -%} Placeholder cards shown in the editor when no collection is selected {%- endcomment -%}
    <ul class="product-showcase__grid" role="list">
      {%- for i in (1..4) -%}
        <li class="product-showcase__item">
          <div class="product-showcase__card">
            <div class="product-showcase__media-wrapper">
              {{ 'product-' | append: i | placeholder_svg_tag: 'product-showcase__image product-showcase__image--primary placeholder-svg' }}
            </div>
            <div class="product-showcase__info">
              <p class="product-showcase__product-title">{{ 'onboarding.product_title' | t }}</p>
              <div class="product-showcase__price">
                <span class="product-showcase__price--regular">{{ 1999 | money }}</span>
              </div>
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

</div>

<style>
  /* =============================================
     Proud Daddy – Product Showcase Section
     Design system: Playfair Display headings,
     Nunito body, navy/gold/cream palette
     ============================================= */

  .product-showcase {
    background: #FAF7F2;
  }

  /* --- Section header: title + shop-all link --- */
  .product-showcase__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 36px;
  }

  .product-showcase__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 700;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    color: #1B2B4B;
    letter-spacing: 0.01em;
    margin: 0;
  }

  .product-showcase__view-all {
    font-family: 'Nunito', sans-serif;
    font-weight: 300;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: #1B2B4B;
    border-bottom: 1px solid #D4973A;
    padding-bottom: 2px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .product-showcase__view-all:hover {
    color: #D4973A;
  }

  /* --- Grid layout --- */
  .product-showcase__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media screen and (max-width: 989px) {
    .product-showcase__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
    }
  }

  @media screen and (max-width: 479px) {
    .product-showcase__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }

  /* --- Card --- */
  .product-showcase__card {
    display: block;
    text-decoration: none;
    color: inherit;
    background: #FAF7F2;
  }

  /* --- Image container --- */
  .product-showcase__media-wrapper {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: #EDE8DF;
  }

  /* Both images fill the container absolutely */
  .product-showcase__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Primary image: always visible, fades out on hover */
  .product-showcase__image--primary {
    opacity: 1;
    transition: opacity 0.45s ease;
  }

  /* Secondary (hover) image: hidden, fades in on hover */
  .product-showcase__image--secondary {
    opacity: 0;
    transition: opacity 0.45s ease;
    z-index: 1;
  }

  .product-showcase__card:hover .product-showcase__image--primary {
    opacity: 0;
  }

  .product-showcase__card:hover .product-showcase__image--secondary {
    opacity: 1;
  }

  /* SVG placeholder */
  .product-showcase__media-wrapper .placeholder-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  /* --- Sale badge --- */
  .product-showcase__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    background: #D4973A;
    color: #FAF7F2;
    font-family: 'Nunito', sans-serif;
    font-weight: 300;
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 4px 10px;
  }

  /* --- Product info --- */
  .product-showcase__info {
    padding: 14px 4px 18px;
  }

  .product-showcase__product-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 400;
    font-size: 0.95rem;
    color: #1A1612;
    margin: 0 0 8px;
    line-height: 1.4;
    letter-spacing: 0.01em;
    transition: color 0.2s ease;
  }

  .product-showcase__card:hover .product-showcase__product-title {
    color: #1B2B4B;
  }

  /* --- Pricing --- */
  .product-showcase__price {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Nunito', sans-serif;
    font-weight: 300;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
  }

  .product-showcase__price--regular {
    color: #8A9AAA;
  }

  .product-showcase__price--compare {
    text-decoration: line-through;
    color: #8A9AAA;
  }

  .product-showcase__price--sale {
    color: #D4973A;
    font-weight: 400;
  }
</style>

{% schema %}
{
  "name": "Product Showcase",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Our Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection to display"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "Number of products to show"
    },
    {
      "type": "checkbox",
      "id": "show_all_link",
      "label": "Show 'Shop all' link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Shop all link text",
      "default": "Shop all"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Product Showcase"
    }
  ]
}
{% endschema %}
